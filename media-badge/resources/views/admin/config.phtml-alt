use function route;
?>

<div class="mbg-admin-page">
    <h2><?= e($title) ?></h2>

    <p class="mbg-admin-help">
        Hinterlege hier die Schlüssel, nach denen das Modul in verknüpften Shared Notes oder Inline-Notes suchen soll.
        Pro Zeile ein Schlüssel, zum Beispiel <code>MEDIA LICENCE</code>.
    </p>

    <form method="post" action="<?= e(route('module', ['module' => $module->name(), 'action' => 'Admin'])) ?>">
        <?= csrf_field() ?>

        <div class="form-group mb-3">
            <label class="form-label" for="note_keys_text">Note keys</label>
            <textarea class="form-control" id="note_keys_text" name="note_keys_text" rows="6"><?= e($note_keys_text) ?></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Speichern</button>

            <a class="btn btn-outline-secondary" href="<?= e(route('module', ['module' => $module->name(), 'action' => 'Badges'])) ?>">
                Badge-Regeln verwalten
            </a>
        </div>
    </form>
</div>
