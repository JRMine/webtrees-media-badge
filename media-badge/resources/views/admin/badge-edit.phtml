<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Fact;
use Fisharebest\Webtrees\Family;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Location;
use Fisharebest\Webtrees\Media;
use Fisharebest\Webtrees\Note;
use Fisharebest\Webtrees\Source;
use Fisharebest\Webtrees\Tree;
use Illuminate\Support\Collection;

/**
 * @var Collection<int,Fact>       $clipboard_facts
 * @var Collection<int,Family>     $linked_families
 * @var Collection<int,Individual> $linked_individuals
 * @var Collection<int,Location>   $linked_locations
 * @var Collection<int,Note>       $linked_notes
 * @var Collection<int,Source>     $linked_sources
 * @var Media                      $record
 * @var Tree                       $tree
 */

$extractMediaLicence = static function (Media $record): ?string {
    foreach ($record->facts(['NOTE']) as $fact) {
        $note_text = '';

        $target = $fact->target();
        if ($target instanceof Note) {
            $note_text = $target->getNote();
        } else {
            $note_text = $fact->value();
        }

        if (preg_match('/^\s*MEDIA LICENCE:\s*(.+)\s*$/mi', $note_text, $match) === 1) {
            return trim($match[1]);
        }
    }

    return null;
};

$getBadgeClass = static function (?string $licence): string {
    if ($licence === null || $licence === '') {
        return 'mbg-badge mbg-badge--generic';
    }

    $normalized = strtolower(trim($licence));

    if ($normalized === 'cc by 4.0') {
        return 'mbg-badge mbg-badge--ccby';
    }

    if ($normalized === 'cc by-sa 4.0') {
        return 'mbg-badge mbg-badge--ccbysa';
    }

    if ($normalized === 'public domain' || $normalized === 'gemeinfrei') {
        return 'mbg-badge mbg-badge--public-domain';
    }

    if (
        $normalized === 'private'
        || $normalized === 'private / no reuse'
        || $normalized === 'privat'
        || $normalized === 'nicht nachnutzen'
    ) {
        return 'mbg-badge mbg-badge--private';
    }

    return 'mbg-badge mbg-badge--generic';
};

$licence = $extractMediaLicence($record);
$badge_class = $getBadgeClass($licence);

?>

