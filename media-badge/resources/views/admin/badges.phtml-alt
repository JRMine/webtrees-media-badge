
<?php

declare(strict_types=1);

/**
 * @var array<int,array<string,mixed>> $rules
 * @var string $title
 * @var \Vendor\Webtrees\Module\MediaBadge\MediaBadgeModule $module
 */

use function route;
?>

<div class="mbg-admin-page">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><?= e($title) ?></h2>

        <a class="btn btn-primary" href="<?= e(route('module', ['module' => $module->name(), 'action' => 'BadgeEdit'])) ?>">
            Neue Badge-Regel
        </a>
    </div>

    <p class="mbg-admin-help">
        Diese Regeln steuern, welche Werte aus den Medien-Notizen als Badge dargestellt werden.
    </p>

    <?php if ($rules === []) : ?>
        <p>Es sind noch keine Badge-Regeln vorhanden.</p>
    <?php else : ?>
        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle">
                <thead>
                    <tr>
                        <th>Aktiv</th>
                        <th>Key</th>
                        <th>Match</th>
                        <th>Label</th>
                        <th>CSS-Klasse</th>
                        <th>Position</th>
                        <th>Reihenfolge</th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($rules as $rule) : ?>
                        <tr>
                            <td><?= $rule['enabled'] ? 'Ja' : 'Nein' ?></td>
                            <td><code><?= e($rule['key']) ?></code></td>
                            <td>
                                <strong><?= e($rule['match_type']) ?></strong><br>
                                <code><?= e($rule['match_value']) ?></code>
                            </td>
                            <td><?= e($rule['label']) ?></td>
                            <td><code><?= e($rule['class']) ?></code></td>
                            <td><?= e($rule['position']) ?></td>
                            <td><?= e((string) $rule['sort_order']) ?></td>
                            <td class="text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="<?= e(route('module', [
                                    'module' => $module->name(),
                                    'action' => 'BadgeEdit',
                                    'id'     => $rule['id'],
                                ])) ?>">
                                    Bearbeiten
                                </a>

                                <form method="post" action="<?= e(route('module', [
                                    'module' => $module->name(),
                                    'action' => 'BadgeDelete',
                                ])) ?>" class="d-inline">
                                    <?= csrf_field() ?>
                                    <input type="hidden" name="id" value="<?= e($rule['id']) ?>">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Löschen
                                    </button>
                                </form>
                            </td>
                        </tr>
                    <?php endforeach ?>
                </tbody>
            </table>
        </div>
    <?php endif ?>

    <div class="mt-3">
        <a class="btn btn-outline-secondary" href="<?= e(route('module', ['module' => $module->name(), 'action' => 'Admin'])) ?>">
            Zurück zu den Einstellungen
        </a>
    </div>
</div>
