<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Media;
use Vendor\Webtrees\Module\MediaBadge\MediaBadgeModule;

/**
 * Reusable badge list component.
 *
 * Resolves all badges for a media record in the current page context,
 * filters them by the requested position, and renders them using the
 * shared single-badge component.
 *
 * @var Media  $record
 * @var string $position
 * @var string $page_context
 */

$position     = $position ?? 'after-title';
$page_context = $page_context ?? 'media-page';

$badges = array_values(array_filter(
    MediaBadgeModule::resolveBadgesForMedia($record, $page_context),
    static fn (array $badge): bool => ($badge['position'] ?? 'after-title') === $position
));

if ($badges === []) {
    return;
}
?>

<span class="mbg-badge-list mbg-badge-list--<?= e($position) ?>"
      data-mbg-position="<?= e($position) ?>"
      data-mbg-page-context="<?= e($page_context) ?>">
    <?php foreach ($badges as $badge) : ?>
        <?= view(MediaBadgeModule::MODULE_NAME . '::components/media-badge', ['badge' => $badge]) ?>
    <?php endforeach ?>
</span>
