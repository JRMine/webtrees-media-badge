<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Fact;
use Fisharebest\Webtrees\Family;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Location;
use Fisharebest\Webtrees\Media;
use Fisharebest\Webtrees\Note;
use Fisharebest\Webtrees\Source;
use Fisharebest\Webtrees\Tree;
use Illuminate\Support\Collection;
use Vendor\Webtrees\Module\MediaBadge\MediaBadgeModule;

/**
 * @var Collection<int,Fact>       $clipboard_facts
 * @var Collection<int,Family>     $linked_families
 * @var Collection<int,Individual> $linked_individuals
 * @var Collection<int,Location>   $linked_locations
 * @var Collection<int,Note>       $linked_notes
 * @var Collection<int,Source>     $linked_sources
 * @var Media                      $record
 * @var Tree                       $tree
 */

$badges = MediaBadgeModule::resolveBadgesForMedia($record);

$before_badges = array_values(array_filter(
    $badges,
    static fn (array $badge): bool => ($badge['position'] ?? 'after-title') === 'before-title'
));

$after_badges = array_values(array_filter(
    $badges,
    static fn (array $badge): bool => ($badge['position'] ?? 'after-title') !== 'before-title'
));

$render_badge = static function (array $badge): string {
    $render_mode = (string) ($badge['render_mode'] ?? 'text');
    $icon_type   = (string) ($badge['icon_type'] ?? 'class');
    $icon_value  = (string) ($badge['icon_value'] ?? '');
    $label       = (string) ($badge['label'] ?? '');
    $title       = (string) ($badge['title'] ?? '');

    if ($render_mode === 'auto') {
        $render_mode = $icon_value !== '' ? 'icon-text' : 'text';
    }

    $show_icon = $render_mode !== 'text' && $icon_value !== '';
    $show_text = $render_mode !== 'icon' && $label !== '';

    if (!$show_icon && !$show_text) {
        return '';
    }

    $class = trim((string) ($badge['class'] ?? 'mbg-badge mbg-badge--generic'));
    if (!$show_text && $show_icon) {
        $class .= ' mbg-badge--icon-only';
    }

    ob_start();
    ?>
    <span class="<?= e($class) ?>"<?php if ($title !== '') : ?> title="<?= e($title) ?>"<?php endif ?>>
        <?php if ($show_icon) : ?>
            <span class="mbg-badge__icon" aria-hidden="true">
                <?php if ($icon_type === 'class') : ?>
                    <i class="<?= e($icon_value) ?>"></i>
                <?php elseif ($icon_type === 'url') : ?>
                    <img src="<?= e($icon_value) ?>" alt="" class="mbg-badge__icon-image">
                <?php else : ?>
                    <?= e($icon_value) ?>
                <?php endif ?>
            </span>
        <?php endif ?>

        <?php if ($show_text) : ?>
            <span class="mbg-badge__label"><?= e($label) ?></span>
        <?php endif ?>
    </span>
    <?php
    return (string) ob_get_clean();
};

?>

<?= view('media-page-pending', ['record' => $record]) ?>

<div class="d-flex mb-4">
    <h2 class="wt-page-title mx-auto d-flex flex-wrap align-items-center justify-content-center gap-2">
        <?php foreach ($before_badges as $badge) : ?>
            <?= $render_badge($badge) ?>
        <?php endforeach ?>

        <span><?= $record->fullName() ?></span>

        <?php foreach ($after_badges as $badge) : ?>
            <?= $render_badge($badge) ?>
        <?php endforeach ?>
    </h2>

    <?php if ($record->canEdit()) : ?>
        <?= view('media-page-menu', ['clipboard_facts' => $clipboard_facts, 'record' => $record]) ?>
    <?php endif ?>
</div>

<div class="wt-page-content">
    <?= view('record-page-links', [
        'details'              => view('media-page-details', ['clipboard_facts' => $clipboard_facts, 'record' => $record]),
        'linked_families'      => $linked_families,
        'linked_individuals'   => $linked_individuals,
        'linked_locations'     => $linked_locations,
        'linked_media_objects' => null,
        'linked_notes'         => $linked_notes,
        'linked_repositories'  => null,
        'linked_sources'       => $linked_sources,
        'linked_submitters'    => null,
        'tree'                 => $tree,
    ]) ?>
</div>

<?= view('modals/ajax') ?>
